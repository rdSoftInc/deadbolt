# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# =========================
# Build / packaging
# =========================
build/
dist/
wheelhouse/

# =========================
# Deadbolt runtime artifacts
# =========================
outputs/
.normalized/
.raw/
.work/

# Explicitly ignore run outputs even if structure changes
outputs/run_*/
outputs/**

# =========================
# Deadbolt local caches
# =========================
.deadbolt/
*.cache.json

# Engagements contain client names, scope, traffic rules, and private notes.
engagements/**
!engagements/example.yaml

# Target lists are private by default. Keep documentation and intentionally
# bundled vulnerable training applications available to contributors.
targets/**
!targets/**/
!targets/**/README.md
!targets/**/*.example.txt
!targets/android/AndroGoat.apk
!targets/ios/iGoat-Swift.ipa

# The active scope is local engagement data. Public examples must use an
# explicit .example suffix.
/scope.yaml
/scope.local.yaml
/scope.local.yml
!/scope.example.yaml
!/scope.example.yml

# =========================
# Reports
# =========================
report.html
reports/
outputs/
*-report.html
*-report.pdf
report-*.html
report-*.pdf

# Browser/proxy captures can contain credentials, cookies, tokens, and bodies.
*.har
*.burp
*.burp2
*.saz
*.pcap
*.pcapng

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Docker
# =========================
*.tar
docker-compose.override.yml

# =========================
# OS / Editor junk
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# =========================
# Secrets (just in case)
# =========================
.env
.env.*
!.env.example
*.secret
*.secrets
*.token
credentials.json
secrets.json
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Explicit escape hatches for analyst notes, evidence, and client exports that
# are created outside Deadbolt's normal outputs directory.
/.private/
/private/
/client-data/
/evidence/

# =========================
# Test scratch
# =========================
tmp/
scratch/
