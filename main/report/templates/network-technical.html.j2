<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Deadbolt Network Technical Report — {{ meta.run_id }}</title>
<style>:root{--ink:#18202b;--muted:#657080;--line:#dfe4ea;--panel:#f6f8fa;--brand:#087e9b;--high:#c43c22;--medium:#a56700;--ok:#22733a}*{box-sizing:border-box}body{margin:0;background:#eef1f4;color:var(--ink);font:14px/1.5 Inter,system-ui,sans-serif}.page{max-width:1180px;margin:28px auto;background:#fff;padding:42px 48px;box-shadow:0 2px 16px #18202b18}header{display:flex;justify-content:space-between;border-bottom:3px solid var(--brand);padding-bottom:20px}h1{margin:0;font-size:25px}h2{margin:34px 0 12px;font-size:18px;border-bottom:1px solid var(--line);padding-bottom:8px}.eyebrow{color:var(--brand);text-transform:uppercase;letter-spacing:.12em;font-weight:700;font-size:11px}.muted{color:var(--muted)}.meta{text-align:right}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid var(--line);border-radius:7px;padding:14px;background:var(--panel)}.number{font-size:24px;font-weight:750}.label{color:var(--muted);font-size:12px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:9px 8px;vertical-align:top}th{color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-size:10px}.mono{font:11px/1.45 ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}.notice{border-left:4px solid #d29a24;background:#fff8e8;padding:12px 14px}.finding{border:1px solid var(--line);border-left:4px solid var(--high);padding:16px;margin:12px 0}.pill{font-size:10px;font-weight:750;text-transform:uppercase}.ok{color:var(--ok)}.bad,.high{color:var(--high)}dl{display:grid;grid-template-columns:155px 1fr}dt{color:var(--muted)}dd{margin:0}.appendix{margin-top:44px;border-top:3px solid var(--brand);padding-top:22px}@media print{body{background:#fff}.page{box-shadow:none;margin:0;max-width:none;padding:20px}.appendix{break-before:page}tr,.finding{break-inside:avoid}}</style></head><body><main class="page">
<header><div><div class="eyebrow">Deadbolt / Technical assessment</div><h1>Network Security Assessment</h1><div class="muted">{{ assessment_profile }} profile · Scope-bound Nmap evidence</div></div><div class="meta"><strong>{{ meta.run_id }}</strong><br>{{ meta.finished_at[:19]|replace('T',' ') }} UTC<br>Deadbolt {{ meta.deadbolt_version }}</div></header>
<h2>Assessment overview</h2><dl><dt>Target source</dt><dd class="mono">{{ targets_display }}</dd><dt>Engagement snapshot</dt><dd class="mono">{{ scope_snapshot }}</dd><dt>Engagement SHA-256</dt><dd class="mono">{{ scope_hash }}</dd><dt>Profile</dt><dd>{{ assessment_profile }}</dd><dt>Highest automated signal</dt><dd class="{{ highest_severity }}">{{ highest_severity|upper }}</dd></dl>
<h2>Coverage</h2><div class="grid">{% for item in coverage %}<div class="card"><div class="number">{{ item.value }}</div><div class="label">{{ item.label }}</div></div>{% endfor %}<div class="card"><div class="number">{{ quality.grade|upper }}</div><div class="label">Evidence quality</div></div></div>
<h2>Scope and limitations</h2><div class="notice"><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></div>
<h2>Execution phases</h2><table><thead><tr><th>Phase</th><th>Status</th><th>Duration</th><th>Exit</th><th>XML</th><th>Log</th></tr></thead><tbody>{% for item in phases %}<tr><td><strong>{{ item.name }}</strong></td><td class="{{ 'ok' if item.status == 'complete' else 'bad' }}">{{ item.status|upper }}</td><td>{{ '%.1fs'|format(item.duration) if item.duration is not none else '—' }}</td><td>{{ item.returncode if item.returncode is not none else '—' }}</td><td class="mono">{{ item.output }}</td><td class="mono">{{ item.log }}</td></tr>{% else %}<tr><td colspan="6">No execution records.</td></tr>{% endfor %}</tbody></table>
<h2>Vulnerability signals</h2><p class="muted">Only explicit vulnerable scanner results appear here. Open ports alone are not counted as vulnerabilities.</p>{% for item in findings %}<article class="finding"><span class="pill {{ item.severity }}">{{ item.severity }} · {{ item.verification_status }}</span><h3>{{ item.title }}</h3><dl><dt>Asset</dt><dd class="mono">{{ item.asset }}</dd><dt>Evidence</dt><dd class="mono">{{ item.evidence }}</dd></dl><p>{{ item.metadata.description }}</p></article>{% else %}<p>No explicit vulnerability signals were reported.</p>{% endfor %}
<h2>Host inventory</h2><table><thead><tr><th>Primary address</th><th>Status</th><th>Hostnames</th><th>Other addresses</th><th>Best OS candidate</th></tr></thead><tbody>{% for host in hosts %}<tr><td class="mono">{{ host.primary_address }}</td><td>{{ host.status }}</td><td class="mono">{{ host.hostnames|join(', ') or '—' }}</td><td class="mono">{% for a in host.addresses %}{{ a.address }}{% if a.vendor %} ({{ a.vendor }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</td><td>{% if host.os_matches %}{{ host.os_matches[0].name }} ({{ host.os_matches[0].accuracy }}%){% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="5">No hosts observed.</td></tr>{% endfor %}</tbody></table>
<h2>Open service inventory</h2><table><thead><tr><th>Host</th><th>Port</th><th>State</th><th>Service</th><th>Detection</th><th>Product / version</th><th>CPE</th><th>Reason</th></tr></thead><tbody>{% for item in services %}<tr><td class="mono">{{ item.host }}</td><td>{{ item.port }}/{{ item.protocol }}</td><td>{{ item.state }}</td><td>{{ item.service or 'unknown' }}{% if item.original_service %} <span class="muted">(table: {{ item.original_service }})</span>{% endif %}{% if item.tunnel %} ({{ item.tunnel }}){% endif %}</td><td>{{ item.method or 'unknown' }} / {{ item.confidence }}</td><td>{{ item.product or '—' }}{% if item.version %} {{ item.version }}{% endif %}{% if item.extra_info %} · {{ item.extra_info }}{% endif %}</td><td class="mono">{{ item.cpes|join(', ') or '—' }}</td><td>{{ item.reason or '—' }}</td></tr>{% else %}<tr><td colspan="8">No open services observed.</td></tr>{% endfor %}</tbody></table>
{% if exposure_review %}<h2>Exposure review queue</h2><p class="muted">These services merit analyst review because of their administrative, legacy, or cleartext role. Presence does not establish a vulnerability.</p><table><thead><tr><th>Host</th><th>Port</th><th>Service</th><th>Review reason</th></tr></thead><tbody>{% for item in exposure_review %}<tr><td class="mono">{{ item.host }}</td><td>{{ item.port }}/{{ item.protocol }}</td><td>{{ item.service }}</td><td>{{ item.review_reason }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if os_observations %}<h2>OS detection evidence</h2><table><thead><tr><th>Host</th><th>Candidate</th><th>Accuracy</th><th>Classes</th></tr></thead><tbody>{% for item in os_observations %}<tr><td class="mono">{{ item.host }}</td><td>{{ item.name }}</td><td>{{ item.accuracy }}%</td><td>{% for class in item.classes %}{{ class.vendor or '' }} {{ class.family or '' }} {{ class.generation or '' }}{% if not loop.last %}; {% endif %}{% endfor %}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if scripts %}<h2>Nmap script evidence</h2><table><thead><tr><th>Host</th><th>Port</th><th>Script</th><th>Output</th></tr></thead><tbody>{% for item in scripts %}<tr><td class="mono">{{ item.host }}</td><td>{{ (item.port ~ '/' ~ item.protocol) if item.port else 'host' }}</td><td class="mono">{{ item.id }}</td><td class="mono">{{ item.output }}</td></tr>{% endfor %}</tbody></table>{% endif %}
<section class="appendix"><div class="eyebrow">Supporting data</div><h1>Coverage inventory</h1>{% for stage in coverage %}<h2>{{ stage.label }} ({{ stage.value }})</h2>{% if stage['items'] %}<ol>{% for item in stage['items'] %}<li class="mono">{{ item }}</li>{% endfor %}</ol>{% else %}<p class="muted">Detailed records are available in normalized/network-inventory.json.</p>{% endif %}{% endfor %}</section>
<p class="muted">Generated from hashed raw Nmap XML. Evidence paths are relative to the run directory.</p></main></body></html>
