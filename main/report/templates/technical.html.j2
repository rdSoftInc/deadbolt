<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Deadbolt Technical Report — {{ meta.run_id }}</title>
<style>
:root{--ink:#18202b;--muted:#657080;--line:#dfe4ea;--panel:#f6f8fa;--brand:#087e9b;--critical:#a41025;--high:#c43c22;--medium:#a56700;--low:#396b25}
*{box-sizing:border-box}body{margin:0;background:#eef1f4;color:var(--ink);font:14px/1.5 Inter,system-ui,sans-serif}.page{max-width:1180px;margin:28px auto;background:white;padding:42px 48px;box-shadow:0 2px 16px #18202b18}header{display:flex;justify-content:space-between;border-bottom:3px solid var(--brand);padding-bottom:20px}h1{margin:0;font-size:25px}h2{margin:34px 0 12px;font-size:18px;border-bottom:1px solid var(--line);padding-bottom:8px}h3{margin:20px 0 8px}.eyebrow,.muted{color:var(--muted)}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-weight:700;font-size:11px}.meta{text-align:right}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card{border:1px solid var(--line);border-radius:7px;padding:14px;background:var(--panel)}.number{font-size:24px;font-weight:750}.label{color:var(--muted);font-size:12px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:9px 8px;vertical-align:top}th{color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-size:10px}.mono{font:11px/1.45 ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}.pill{display:inline-block;border-radius:999px;padding:2px 8px;background:#e8edf1;font-size:10px;font-weight:750;text-transform:uppercase}.critical{color:var(--critical)}.high{color:var(--high)}.medium{color:var(--medium)}.low{color:var(--low)}.finding{border:1px solid var(--line);border-left:4px solid;padding:18px;margin:12px 0;border-radius:5px}.finding.high{border-left-color:var(--high)}.finding.medium{border-left-color:var(--medium)}dl{display:grid;grid-template-columns:155px 1fr;margin:10px 0}dt{color:var(--muted)}dd{margin:0}.notice{border-left:4px solid #d29a24;background:#fff8e8;padding:12px 14px}.ok{color:#22733a}.bad{color:var(--high)}.neutral{color:var(--muted)}.appendix{margin-top:46px;border-top:3px solid var(--brand);padding-top:24px}.inventory{columns:2;column-gap:28px;margin:8px 0 26px;padding-left:22px}.inventory li{break-inside:avoid;margin:3px 0;font:11px/1.45 ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}@media print{body{background:white}.page{box-shadow:none;margin:0;max-width:none;padding:20px}.finding{break-inside:avoid}.appendix{break-before:page}.inventory-section{break-inside:avoid}}
</style></head><body><main class="page">
<header><div><div class="eyebrow">Deadbolt / Technical assessment</div><h1>{{ domain|upper }} Security Assessment</h1><div class="muted">{{ assessment_profile }} profile · Evidence-led scanner output and coverage record</div></div><div class="meta"><strong>{{ meta.run_id }}</strong><br>{{ meta.started_at[:19]|replace('T',' ') }} UTC<br>Deadbolt {{ meta.deadbolt_version }}</div></header>

<h2>Assessment overview</h2>
<dl><dt>Assessment profile</dt><dd>{{ assessment_profile }}</dd><dt>Target source</dt><dd class="mono">{{ targets_display }}</dd><dt>Authorization scope</dt><dd class="mono">{{ scope_snapshot }}</dd><dt>Scope SHA-256</dt><dd class="mono">{{ scope_hash }}</dd><dt>Report threshold</dt><dd>{{ min_severity|upper }} and above</dd><dt>Highest automated signal</dt><dd class="{{ highest_severity }}">{{ highest_severity|upper }}</dd><dt>Scanner errors</dt><dd>{{ errors|length }}</dd></dl>

<h2>Coverage funnel</h2><div class="grid">{% for stage in coverage %}<div class="card"><div class="number">{{ stage.value }}</div><div class="label">{{ stage.label }}</div></div>{% endfor %}</div>

{% if limitations %}<h2>Scope and limitations</h2><div class="notice"><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}

<h2>Tool execution</h2><table><thead><tr><th>Tool</th><th>Version</th><th>Status</th><th>Duration</th><th>Reason</th><th>Artifact</th></tr></thead><tbody>{% for tool in executions %}<tr><td><strong>{{ tool.name }}</strong></td><td>{{ tool.version }}</td><td class="{{ tool.status_class }}">{{ tool.status|upper }}</td><td>{{ tool.duration }}</td><td>{{ tool.reason or tool.error or '—' }}</td><td class="mono">{{ tool.artifact }}{% if tool.status != 'not_applicable' and tool.artifact != '—' and not tool.artifact_present %} (missing){% endif %}</td></tr>{% endfor %}</tbody></table>

<h2>Vulnerability signals</h2><p class="muted">{{ findings|length }} automated matches. A match is not a confirmed vulnerability until an analyst reproduces it.</p>
{% for f in findings %}<article class="finding {{ f.severity }}"><div><span class="pill {{ f.severity }}">{{ f.severity }}</span> <span class="pill">{{ f.verification_status }}</span></div><h3>{{ f.title }}</h3><dl><dt>Asset</dt><dd class="mono">{{ f.asset }}</dd><dt>Scanner severity</dt><dd>{{ f.tool_severity|upper }}</dd><dt>Deadbolt severity</dt><dd>{{ f.severity|upper }}{% if f.metadata.cvss_score %} (CVSS {{ f.metadata.cvss_score }}){% endif %}</dd><dt>Template</dt><dd class="mono">{{ f.template_id or '—' }}</dd><dt>Matched at</dt><dd class="mono">{{ f.metadata.matched_at or '—' }}</dd><dt>Evidence</dt><dd class="mono">{{ f.evidence }}</dd></dl>{% if f.metadata.description %}<p>{{ f.metadata.description }}</p>{% endif %}</article>{% else %}<p>No findings met the reporting threshold.</p>{% endfor %}

<h2>In-scope attack surface</h2><p class="muted">{{ surface|length }} normalized URLs from {{ surface_observations }} scanner observations. Recursive crawler artifacts are omitted.</p><table><thead><tr><th>Asset or endpoint</th><th>Surface type</th><th>Observed by</th><th>HTTP</th><th>Evidence</th></tr></thead><tbody>{% for item in surface %}<tr><td class="mono">{{ item.asset }}</td><td>{{ item.surface_type }}</td><td>{{ item.sources|join(', ') }}</td><td>{{ item.status_code or '—' }}</td><td class="mono">{{ item.evidence }}</td></tr>{% else %}<tr><td colspan="5">No in-scope surface records.</td></tr>{% endfor %}</tbody></table>

{% if route_candidates or route_rejections %}<h2>Route-quality exclusions</h2><p class="muted">Responsive URLs below were retained as evidence but excluded from vulnerability scanning.</p><table><thead><tr><th>URL</th><th>Disposition</th><th>Reason</th><th>Observed by</th></tr></thead><tbody>{% for item in route_candidates + route_rejections %}<tr><td class="mono">{{ item.url }}</td><td>{{ item.disposition }}</td><td>{{ item.reason }}</td><td>{{ item.sources|join(', ') }}</td></tr>{% endfor %}</tbody></table>{% endif %}

<h2>API request inventory</h2>{% if api_inventory %}<p class="muted">Prioritized analyst handoff from canonical API evidence. Suggested reviews are test families, not vulnerability findings. Values that could contain credentials or user data are not stored.</p><table><thead><tr><th>Priority</th><th>Purpose</th><th>Method</th><th>Resolved endpoint and raw expression</th><th>Evidence</th><th>Scope</th><th>Confidence</th><th>Parameters</th><th>Suggested manual review</th><th>Request semantics</th><th>Response intelligence</th><th>Source</th><th>HTTP</th></tr></thead><tbody>{% for item in api_inventory %}<tr><td><strong>{{ item.review_priority|upper }}</strong><br><span class="muted">{{ item.priority_score }}</span></td><td>{{ item.purpose or 'Application API' }}</td><td><strong>{{ item.method or '—' }}</strong></td><td class="mono"><span class="muted">resolved:</span> {{ item.url }}{% for expression in item.raw_expressions %}<br><span class="muted">raw:</span> {{ expression }}{% endfor %}</td><td>{{ item.evidence_status|upper }}</td><td>{{ item.scope_status|upper|replace('_', ' ') }}</td><td>{{ item.confidence|upper }}</td><td>{% set parameters = item.query_parameters + item.path_parameters %}{{ parameters|map(attribute='name')|join(', ') }}{% if parameters and item.request_body_fields %}; {% endif %}{% for field in item.request_body_fields %}{{ field.name }}{% if field.data_type %} ({{ field.data_type }}{% if field.required %}, required{% endif %}){% elif field.required %} (required){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% if not parameters and not item.request_body_fields %}—{% endif %}{% if item.client_validation_rules %}<br><span class="muted">client validation: {{ item.client_validation_rules|join('; ') }}</span>{% endif %}</td><td>{{ item.suggested_manual_review|join('; ') or '—' }}</td><td>{% if item.preflight_observed %}CORS preflight observed<br>{% endif %}{% if item.request_header_names %}headers: {{ item.request_header_names|join(', ') }}<br>{% endif %}{% if item.credentials_mode %}credentials: {{ item.credentials_mode }}<br>{% endif %}{% if item.wrapper_chain %}wrapper: {{ item.wrapper_chain|join(' → ') }}{% endif %}{% if not item.preflight_observed and not item.request_header_names and not item.credentials_mode and not item.wrapper_chain %}—{% endif %}</td><td>{% if item.response_fields %}fields: {{ item.response_fields|join(', ') }}<br>{% endif %}{% if item.application_technologies %}application: {{ item.application_technologies|join(', ') }}<br>{% endif %}{% if item.infrastructure_technologies %}infrastructure: {{ item.infrastructure_technologies|join(', ') }}<br>{% endif %}{% if item.api_version_indicators %}version: {{ item.api_version_indicators|join(', ') }}<br>{% endif %}{% if item.framework_signals %}{{ item.framework_signals|join('; ') }}<br>{% endif %}{% if item.infrastructure_cookie_names %}infrastructure cookies: {{ item.infrastructure_cookie_names|join(', ') }}{% endif %}{% if not item.response_fields and not item.application_technologies and not item.infrastructure_technologies and not item.api_version_indicators and not item.framework_signals and not item.infrastructure_cookie_names %}—{% endif %}</td><td>{{ item.source }}</td><td>{{ item.status_code if item.status_code is not none else '—' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">{{ api_inventory_note }}</p>{% endif %}

{% set schema_conflicts = api_inventory|selectattr("request_schema_conflicts")|list %}{% if schema_conflicts %}<h2>Request-schema conflicts</h2><p class="muted">Browser-observed structure remains authoritative. Conflicting static evidence is preserved below for analyst review.</p><table><thead><tr><th>Operation</th><th>Field</th><th>Location</th><th>Attribute</th><th>Observed</th><th>Inferred</th></tr></thead><tbody>{% for item in schema_conflicts %}{% for conflict in item.request_schema_conflicts %}<tr><td class="mono">{{ item.method or "—" }} {{ item.url }}</td><td>{{ conflict.field_name }}</td><td>{{ conflict.location }}</td><td>{{ conflict.attribute }}</td><td>{{ conflict.observed }}</td><td>{{ conflict.inferred }}</td></tr>{% endfor %}{% endfor %}</tbody></table>{% endif %}

{% if excluded_surface %}<h2>Discovered but excluded by scope</h2><p class="muted">These records were retained for auditability but were not authorized for downstream scanning.</p><table><thead><tr><th>Asset or endpoint</th><th>Type</th><th>Observed by</th></tr></thead><tbody>{% for item in excluded_surface %}<tr><td class="mono">{{ item.asset }}</td><td>{{ item.kind }}</td><td>{{ item.sources|join(', ') }}</td></tr>{% endfor %}</tbody></table>{% endif %}

<section class="appendix"><div class="eyebrow">Supporting data</div><h1>Coverage inventory</h1><p class="muted">Complete records behind every coverage number, generated from the same run artifacts.</p>{% for stage in coverage %}<div class="inventory-section"><h2>{{ stage.label }} <span class="muted">({{ stage.value }})</span></h2>{% if stage["items"] %}<ol class="inventory">{% for item in stage["items"] %}<li>{{ item }}</li>{% endfor %}</ol>{% else %}<p class="muted">No records.</p>{% endif %}</div>{% endfor %}</section>

<p class="muted" style="margin-top:36px">Generated from immutable run artifacts. Evidence paths are relative to this run directory.</p>
</main></body></html>
